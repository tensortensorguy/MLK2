#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /home/z/.local/lib/python3.13/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/home/z/my-project/mlk2-repo -B/home/z/my-project/mlk2-repo/build-asan
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/z/.local/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/z/.local/bin/ninja -t targets
  description = All primary targets available:

